ed?","options":["lamed","tet","shin","mem"],"correct":2,"prompt":"ש"},{"type":"choice","q":"What is this letter called?","options":["dalet","tav","tet","kaf"],"correct":1,"prompt":"ת"},{"type":"choice","q":"What does this mean?","options":["coffee","believes","day","orange"],"correct":0,"prompt":"קָפֶה","translit":"kafe"},{"type":"choice","q":"What does this mean?","options":["asks","family","head","describes"],"correct":2,"prompt":"רֹאשׁ","translit":"rosh"},{"type":"choice","q":"What does this mean?","options":["fate","long","sun","how"],"correct":2,"prompt":"שֶׁמֶשׁ","translit":"shemesh"},{"type":"choice","q":"Which one is qof?","options":["ר","ק"],"correct":1,"he":true,"why":"ק is qof; ר is resh."},{"type":"choice","q":"Which letter is tav?","options":["פ","ת","ר","ז"],"correct":1,"he":true},{"type":"choice","q":"Which letter is resh?","options":["ו","ר","ע","ש"],"correct":1,"he":true},{"type":"listen","q":"Which word did you hear?","options":["שָׂמֵחַ","קָפֶה","שָׁלוֹם","תֵּה"],"correct":2,"say":"שָׁלוֹם","he":true},{"type":"choice","q":"How do you say “hello, peace”?","options":["שָׁלוֹם","אַכְזָר","תִּקְרָה","מַחֲשָׁבָה"],"correct":0,"he":true},{"type":"match","pairs":[["קָפֶה","coffee"],["רֹאשׁ","head"],["שֶׁמֶשׁ","sun"],["שָׂמֵחַ","happy"],["תֵּה","tea"]]},{"type":"choice","q":"How do you say “happy”?","options":["מִצְוָה","שָׂמֵחַ","אִילוּ","תְּהוֹם"],"correct":1,"he":true},{"type":"choice","q":"Which one is dalet?","options":["ר","ד"],"correct":1,"he":true,"why":"ד is dalet; ר is resh."},{"type":"type","q":"Write “hello, peace” in Hebrew","answer":"שָׁלוֹם","hint":"shalom"}]}