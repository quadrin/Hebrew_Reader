{"id":"b6","level":3,"levelName":"Ulpan Bet","n":7,"of":22,"title":"Days and hours","titleHe":"זְמַן","goal":"Name the days, ask the time, and place things in the week.","sections":[{"type":"text","body":"Hebrew days are numbered, not named — Sunday is day one. Only Saturday has a name of its own."},{"type":"table","caption":"The week","head":["day","Hebrew"],"rows":[["Sunday","יוֹם רִאשׁוֹן"],["Monday","יוֹם שֵׁנִי"],["Tuesday","יוֹם שְׁלִישִׁי"],["Wednesday","יוֹם רְבִיעִי"],["Thursday","יוֹם חֲמִישִׁי"],["Friday","יוֹם שִׁישִׁי"],["Saturday","שַׁבָּת"]]},{"type":"examples","items":[{"he":"מָה הַשָּׁעָה?","en":"What time is it?"},{"he":"בְּשָׁעָה שֶׁבַע.","en":"At seven o'clock."},{"he":"בַּבֹּקֶר, בָּעֶרֶב","en":"in the morning, in the evening"}]}],"vocab":[{"he":"יוֹם","en":"day","translit":"yom"},{"he":"שָׁבוּעַ","en":"week","translit":"shavua"},{"he":"חֹדֶשׁ","en":"month","translit":"chodesh"},{"he":"שָׁעָה","en":"hour, o'clock","translit":"sha'a"},{"he":"דַּקָּה","en":"minute","translit":"daka"},{"he":"בֹּקֶר","en":"morning","translit":"boker"},{"he":"עֶרֶב","en":"evening","translit":"erev"},{"he":"לַיְלָה","en":"night","translit":"layla"},{"he":"מָחָר","en":"tomorrow","translit":"machar"}],"exercises":[{"type":"choice","q":"What does this mean?","options":["the city","speech, speaking","light","day"],"correct":3,"prompt":"יוֹם","translit":"yom"},{"type":"choice","q":"What does this mean?","options":["darkness","prayer book","the city","week"],"correct":3,"prompt":"שָׁבוּעַ","translit":"shavua"},{"type":"choice","q":"What does this mean?","options":["sword","tomorrow","month","good"],"correct":2,"prompt":"חֹדֶשׁ","translit":"chodesh"},{"type":"choice","q":"What does this mean?","options":["hour, o'clock","quickly","honey","then"],"correct":0,"prompt":"שָׁעָה","translit":"sha'a"},{"type":"choice","q":"What does this mean?","options":["culture","minute","enters","more, still, another"],"correct":1,"prompt":"דַּקָּה","translit":"daka"},{"type":"choice","q":"What does this mean?","options":["morning","door","justice","does, makes"],"correct":0,"prompt":"בֹּקֶר","translit":"boker"},{"type":"choice","q":"What does this mean?","options":["weight","ear","knows, is acquainted with","evening"],"correct":3,"prompt":"עֶרֶב","translit":"erev"},{"type":"choice","q":"How do you say “hour, o'clock”?","options":["הָיָה","אֱמֶת","גַּרְבַּיִם","שָׁעָה"],"correct":3,"he":true},{"type":"listen","q":"Which word did you hear?","options":["עֶרֶב","דַּקָּה","חֹדֶשׁ","בֹּקֶר"],"correct":3,"say":"בֹּקֶר","he":true},{"type":"match","pairs":[["יוֹם","day"],["שָׁבוּעַ","week"],["חֹדֶשׁ","month"],["שָׁעָה","hour, o'clock"],["דַּקָּה","minute"]]},{"type":"choice","q":"How do you say “evening”?","options":["עַכְבָּר","בֹּקֶר","עֶרֶב","מָאתַיִם"],"correct":2,"he":true},{"type":"match","pairs":[["בֹּקֶר","morning"],["עֶרֶב","evening"],["לַיְלָה","night"],["מָחָר","tomorrow"]]},{"type":"choice","q":"How do you say “week”?","options":["שָׁבוּעַ","מִדְבָּר","יוֹתֵר","טִפֵּשׁ"],"correct":0,"he":true},{"type":"read","he":"חֹדֶשׁ","translit":"chodesh","en":"month"},{"type":"listen","q":"Which word did you hear?","options":["יוֹם","שָׁעָה","דַּקָּה","מָחָר"],"correct":1,"say":"שָׁעָה","he":true},{"type":"type","q":"Write “night” in Hebrew","answer":"לַיְלָה","hint":"layla"}]}