{"id":"b6","level":3,"levelName":"Ulpan Bet","n":6,"of":9,"title":"Days and hours","titleHe":"זְמַן","goal":"Name the days, ask the time, and place things in the week.","sections":[{"type":"text","body":"Hebrew days are numbered, not named — Sunday is day one. Only Saturday has a name of its own."},{"type":"table","caption":"The week","head":["day","Hebrew"],"rows":[["Sunday","יוֹם רִאשׁוֹן"],["Monday","יוֹם שֵׁנִי"],["Tuesday","יוֹם שְׁלִישִׁי"],["Wednesday","יוֹם רְבִיעִי"],["Thursday","יוֹם חֲמִישִׁי"],["Friday","יוֹם שִׁישִׁי"],["Saturday","שַׁבָּת"]]},{"type":"examples","items":[{"he":"מָה הַשָּׁעָה?","en":"What time is it?"},{"he":"בְּשָׁעָה שֶׁבַע.","en":"At seven o'clock."},{"he":"בַּבֹּקֶר, בָּעֶרֶב","en":"in the morning, in the evening"}]}],"vocab":[{"he":"יוֹם","en":"day","translit":"yom"},{"he":"שָׁבוּעַ","en":"week","translit":"shavua"},{"he":"חֹדֶשׁ","en":"month","translit":"chodesh"},{"he":"שָׁעָה","en":"hour, o'clock","translit":"sha'a"},{"he":"דַּקָּה","en":"minute","translit":"daka"},{"he":"בֹּקֶר","en":"morning","translit":"boker"},{"he":"עֶרֶב","en":"evening","translit":"erev"},{"he":"לַיְלָה","en":"night","translit":"layla"},{"he":"מָחָר","en":"tomorrow","translit":"machar"}],"exercises":[{"type":"choice","q":"What does this mean?","options":["girl","hello, peace","saying (introduces speech)","day"],"correct":3,"prompt":"יוֹם","translit":"yom"},{"type":"choice","q":"What does this mean?","options":["on me, about me","week","my, mine","even"],"correct":1,"prompt":"שָׁבוּעַ","translit":"shavua"},{"type":"choice","q":"What does this mean?","options":["here is, behold","come! (f.)","month","book"],"correct":2,"prompt":"חֹדֶשׁ","translit":"chodesh"},{"type":"choice","q":"What does this mean?","options":["from","table","hour, o'clock","city"],"correct":2,"prompt":"שָׁעָה","translit":"sha'a"},{"type":"choice","q":"What does this mean?","options":["minute","and he went","student (m.)","his"],"correct":0,"prompt":"דַּקָּה","translit":"daka"},{"type":"choice","q":"What does this mean?","options":["peace","morning","I am not (literary)","of"],"correct":1,"prompt":"בֹּקֶר","translit":"boker"},{"type":"choice","q":"What does this mean?","options":["grandfather","excuse me, sorry","evening","not yet"],"correct":2,"prompt":"עֶרֶב","translit":"erev"},{"type":"choice","q":"How do you say “month”?","options":["מֶלֶךְ","הַבַּיְתָה","חֹדֶשׁ","מְשַׂחֵק"],"correct":2,"he":true},{"type":"listen","q":"Which word did you hear?","options":["חֹדֶשׁ","בֹּקֶר","מָחָר","עֶרֶב"],"correct":3,"say":"עֶרֶב","he":true},{"type":"listen","q":"Which word did you hear?","options":["מָחָר","לַיְלָה","שָׁבוּעַ","בֹּקֶר"],"correct":1,"say":"לַיְלָה","he":true},{"type":"choice","q":"How do you say “hour, o'clock”?","options":["בַּיִת","שֶׁלִּי","רוֹאֶה","שָׁעָה"],"correct":3,"he":true},{"type":"choice","q":"How do you say “night”?","options":["חֲבֵרָה","לַיְלָה","עוֹד","כְּבָר"],"correct":1,"he":true},{"type":"choice","q":"How do you say “day”?","options":["בִּכְלָל","יוֹם","מִי","בְּעֶצֶם"],"correct":1,"he":true},{"type":"match","pairs":[["שָׁבוּעַ","week"],["יוֹם","day"],["עֶרֶב","evening"],["מָחָר","tomorrow"],["בֹּקֶר","morning"]]},{"type":"read","he":"יוֹם","translit":"yom","en":"day"},{"type":"listen","q":"Which word did you hear?","options":["חֹדֶשׁ","מָחָר","בֹּקֶר","יוֹם"],"correct":3,"say":"יוֹם","he":true}]}