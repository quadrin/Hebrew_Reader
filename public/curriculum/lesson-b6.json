{"id":"b6","level":3,"levelName":"Ulpan Bet","n":7,"of":17,"title":"Days and hours","titleHe":"זְמַן","goal":"Name the days, ask the time, and place things in the week.","sections":[{"type":"text","body":"Hebrew days are numbered, not named — Sunday is day one. Only Saturday has a name of its own."},{"type":"table","caption":"The week","head":["day","Hebrew"],"rows":[["Sunday","יוֹם רִאשׁוֹן"],["Monday","יוֹם שֵׁנִי"],["Tuesday","יוֹם שְׁלִישִׁי"],["Wednesday","יוֹם רְבִיעִי"],["Thursday","יוֹם חֲמִישִׁי"],["Friday","יוֹם שִׁישִׁי"],["Saturday","שַׁבָּת"]]},{"type":"examples","items":[{"he":"מָה הַשָּׁעָה?","en":"What time is it?"},{"he":"בְּשָׁעָה שֶׁבַע.","en":"At seven o'clock."},{"he":"בַּבֹּקֶר, בָּעֶרֶב","en":"in the morning, in the evening"}]}],"vocab":[{"he":"יוֹם","en":"day","translit":"yom"},{"he":"שָׁבוּעַ","en":"week","translit":"shavua"},{"he":"חֹדֶשׁ","en":"month","translit":"chodesh"},{"he":"שָׁעָה","en":"hour, o'clock","translit":"sha'a"},{"he":"דַּקָּה","en":"minute","translit":"daka"},{"he":"בֹּקֶר","en":"morning","translit":"boker"},{"he":"עֶרֶב","en":"evening","translit":"erev"},{"he":"לַיְלָה","en":"night","translit":"layla"},{"he":"מָחָר","en":"tomorrow","translit":"machar"}],"exercises":[{"type":"choice","q":"What does this mean?","options":["day","roof","sugar","restaurant"],"correct":0,"prompt":"יוֹם","translit":"yom"},{"type":"choice","q":"What does this mean?","options":["form, shape","fear","week","revolution"],"correct":2,"prompt":"שָׁבוּעַ","translit":"shavua"},{"type":"choice","q":"What does this mean?","options":["carpet","school","café","month"],"correct":3,"prompt":"חֹדֶשׁ","translit":"chodesh"},{"type":"choice","q":"What does this mean?","options":["hour, o'clock","buys","illness","stairs"],"correct":0,"prompt":"שָׁעָה","translit":"sha'a"},{"type":"choice","q":"What does this mean?","options":["autumn","sofa","minute","feeling, emotion"],"correct":2,"prompt":"דַּקָּה","translit":"daka"},{"type":"choice","q":"What does this mean?","options":["solution","morning","season","illness"],"correct":1,"prompt":"בֹּקֶר","translit":"boker"},{"type":"choice","q":"What does this mean?","options":["glass, cup","evening","since then","and he went"],"correct":1,"prompt":"עֶרֶב","translit":"erev"},{"type":"choice","q":"How do you say “month”?","options":["אַף עַל פִּי","חֹדֶשׁ","רָחוֹק","בָּא"],"correct":1,"he":true},{"type":"read","he":"לַיְלָה","translit":"layla","en":"night"},{"type":"choice","q":"How do you say “night”?","options":["לַיְלָה","תְּרוּפָה","אַרְבָּעִים","נָדִיב"],"correct":0,"he":true},{"type":"choice","q":"How do you say “minute”?","options":["שָׁחֹר","מְפַחֵד","צִפּוֹר","דַּקָּה"],"correct":3,"he":true},{"type":"match","pairs":[["יוֹם","day"],["שָׁבוּעַ","week"],["חֹדֶשׁ","month"],["שָׁעָה","hour, o'clock"],["דַּקָּה","minute"]]},{"type":"listen","q":"Which word did you hear?","options":["עֶרֶב","מָחָר","שָׁבוּעַ","לַיְלָה"],"correct":0,"say":"עֶרֶב","he":true},{"type":"listen","q":"Which word did you hear?","options":["שָׁבוּעַ","חֹדֶשׁ","לַיְלָה","דַּקָּה"],"correct":3,"say":"דַּקָּה","he":true},{"type":"match","pairs":[["בֹּקֶר","morning"],["עֶרֶב","evening"],["לַיְלָה","night"],["מָחָר","tomorrow"]]},{"type":"type","q":"Write “night” in Hebrew","answer":"לַיְלָה","hint":"layla"}]}