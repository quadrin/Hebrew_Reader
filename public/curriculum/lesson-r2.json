","samekh","vav","tet"],"correct":3,"prompt":"ט"},{"type":"choice","q":"What is this letter called?","options":["resh","pe","yod","he"],"correct":2,"prompt":"י"},{"type":"choice","q":"What is this letter called?","options":["samekh","tsadi","kaf","vav"],"correct":2,"prompt":"כ"},{"type":"choice","q":"What is this letter called?","options":["zayin","lamed","tav","kaf"],"correct":1,"prompt":"ל"},{"type":"choice","q":"What does this mean?","options":["but","exile","cloud","this"],"correct":3,"prompt":"זֶה","translit":"ze"},{"type":"choice","q":"How do you say “strength”?","options":["כֹּחַ","נוֹסֵעַ","מִשְׁקָפַיִם","נְדַבֵּר"],"correct":0,"he":true},{"type":"match","pairs":[["זֶה","this"],["חַג","holiday"],["טוֹב","good"],["יָד","hand"],["כֹּחַ","strength"]]},{"type":"choice","q":"Which letter is zayin?","options":["ח","פ","ז","ת"],"correct":2,"he":true},{"type":"choice","q":"Which letter is chet?","options":["ח","ו","מ","ב"],"correct":0,"he":true},{"type":"choice","q":"Which one is vav?","options":["ו","ז"],"correct":0,"he":true,"why":"ו is vav; ז is zayin."},{"type":"choice","q":"Which one is he?","options":["ה","ח"],"correct":0,"he":true,"why":"ה is he; ח is chet."},{"type":"read","he":"חַג","translit":"chag","en":"holiday"},{"type":"choice","q":"Which letter is yod?","options":["ה","י","ז","ט"],"correct":1,"he":true},{"type":"type","q":"Write “strength” in Hebrew","answer":"כֹּחַ","hint":"koach"}]}