{"id":"b1","level":3,"levelName":"Ulpan Bet","n":1,"of":17,"title":"Whose it is","titleHe":"שֶׁל","goal":"Say that something belongs to someone.","sections":[{"type":"text","body":"שֶׁל is of. It goes between the thing and its owner, and the thing takes the article: הַסֵּפֶר שֶׁל דָּוִד, David's book — literally the book of David."},{"type":"text","body":"With a pronoun, שֶׁל takes an ending rather than standing alone."},{"type":"table","caption":"שֶׁל with endings","head":["","singular","plural"],"rows":[["1st","שֶׁלִּי — my","שֶׁלָּנוּ — our"],["2nd m.","שֶׁלְּךָ — your","שֶׁלָּכֶם — your"],["2nd f.","שֶׁלָּךְ — your","שֶׁלָּכֶן — your"],["3rd m.","שֶׁלּוֹ — his","שֶׁלָּהֶם — their"],["3rd f.","שֶׁלָּהּ — her","שֶׁלָּהֶן — their"]]},{"type":"examples","items":[{"he":"הַבַּיִת שֶׁלִּי","en":"my house"},{"he":"הַמִּשְׁפָּחָה שֶׁלָּהּ","en":"her family"},{"he":"הַסְּפָרִים שֶׁלָּנוּ","en":"our books"}]}],"vocab":[{"he":"שֶׁל","en":"of","translit":"shel"},{"he":"שֶׁלִּי","en":"my, mine","translit":"sheli"},{"he":"שֶׁלְּךָ","en":"your (m.)","translit":"shelcha"},{"he":"שֶׁלָּךְ","en":"your (f.)","translit":"shelach"},{"he":"שֶׁלּוֹ","en":"his","translit":"shelo"},{"he":"שֶׁלָּהּ","en":"her","translit":"shela"},{"he":"שֶׁלָּנוּ","en":"our","translit":"shelanu"}],"exercises":[{"type":"choice","q":"What does this mean?","options":["of","yellow","pleasant","maybe"],"correct":0,"prompt":"שֶׁל","translit":"shel"},{"type":"choice","q":"What does this mean?","options":["dad","my, mine","hates","religion"],"correct":1,"prompt":"שֶׁלִּי","translit":"sheli"},{"type":"choice","q":"What does this mean?","options":["then","bone","grey","your (m.)"],"correct":3,"prompt":"שֶׁלְּךָ","translit":"shelcha"},{"type":"choice","q":"What does this mean?","options":["Nisan (Mar–Apr)","end","explains","your (f.)"],"correct":3,"prompt":"שֶׁלָּךְ","translit":"shelach"},{"type":"choice","q":"What does this mean?","options":["his","agrees","to the left","company, society"],"correct":0,"prompt":"שֶׁ