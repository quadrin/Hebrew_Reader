{"id":"b1","level":3,"levelName":"Ulpan Bet","n":1,"of":9,"title":"Whose it is","titleHe":"שֶׁל","goal":"Say that something belongs to someone.","sections":[{"type":"text","body":"שֶׁל is of. It goes between the thing and its owner, and the thing takes the article: הַסֵּפֶר שֶׁל דָּוִד, David's book — literally the book of David."},{"type":"text","body":"With a pronoun, שֶׁל takes an ending rather than standing alone."},{"type":"table","caption":"שֶׁל with endings","head":["","singular","plural"],"rows":[["1st","שֶׁלִּי — my","שֶׁלָּנוּ — our"],["2nd m.","שֶׁלְּךָ — your","שֶׁלָּכֶם — your"],["2nd f.","שֶׁלָּךְ — your","שֶׁלָּכֶן — your"],["3rd m.","שֶׁלּוֹ — his","שֶׁלָּהֶם — their"],["3rd f.","שֶׁלָּהּ — her","שֶׁלָּהֶן — their"]]},{"type":"examples","items":[{"he":"הַבַּיִת שֶׁלִּי","en":"my house"},{"he":"הַמִּשְׁפָּחָה שֶׁלָּהּ","en":"her family"},{"he":"הַסְּפָרִים שֶׁלָּנוּ","en":"our books"}]}],"vocab":[{"he":"שֶׁל","en":"of","translit":"shel"},{"he":"שֶׁלִּי","en":"my, mine","translit":"sheli"},{"he":"שֶׁלְּךָ","en":"your (m.)","translit":"shelcha"},{"he":"שֶׁלָּךְ","en":"your (f.)","translit":"shelach"},{"he":"שֶׁלּוֹ","en":"his","translit":"shelo"},{"he":"שֶׁלָּהּ","en":"her","translit":"shela"},{"he":"שֶׁלָּנוּ","en":"our","translit":"shelanu"}],"exercises":[{"type":"choice","q":"What does this mean?","options":["I (archaic)","does, makes","if","of"],"correct":3,"prompt":"שֶׁל","translit":"shel"},{"type":"choice","q":"What does this mean?","options":["land, country","my, mine","to me","student (m.)"],"correct":1,"prompt":"שֶׁלִּי","translit":"sheli"},{"type":"choice","q":"What does this mean?","options":["grandfather","speaks","your (m.)","even"],"correct":2,"prompt":"שֶׁלְּךָ","translit":"shelcha"},{"type":"choice","q":"What does this mean?","options":["your (f.)","don't (with the future)","teacher (f.)","knows, is acquainted with"],"correct":0,"prompt":"שֶׁלָּךְ","translit":"shelach"},{"type":"choice","q":"What does this mean?","options":["son","mouth"