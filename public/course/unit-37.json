, ולכן תאמינו לי כי יודע אני היטב את אשר בן אדם יכול לעשות ואת אשר בן אדם אינו יכול לעשות.","words":74,"coverage":77,"practises":0},"src":{"name":"Project Ben-Yehuda","license":"Public domain","credit":"Project Ben-Yehuda volunteers","url":"https://benyehuda.org/read/6911"}}