{"n":39,"level":3,"levelName":"Fluent reading","knownAfter":1350,"words":[{"he":"יעשו","en":"","pos":""},{"he":"עצם","en":"","pos":""},{"he":"לעיני","en":"","pos":""},{"he":"עשיתי","en":"","pos":""},{"he":"ומיד","en":"","pos":""},{"he":"הבריות","en":"","pos":""},{"he":"נשארו","en":"","pos":""},{"he":"יהא","en":"","pos":""},{"he":"הקרקע","en":"","pos":""},{"he":"רשות","en":"","pos":""},{"he":"חכמים","en":"","pos":""},{"he":"השלום","en":"","pos":""},{"he":"צער","en":"","pos":""},{"he":"ארבעה","en":"","pos":""},{"he":"אחריהם","en":"","pos":""},{"he":"מלחמת","en":"","pos":""},{"he":"בכדי","en":"","pos":""},{"he":"המושבה","en":"","pos":""},{"he":"ממקומו","en":"","pos":""},{"he":"יקרה","en":"","pos":""},{"he":"לפנות","en":"","pos":""},{"he":"לבד","en":"","pos":""},{"he":"והרי","en":"","pos":""},{"he":"נחוץ","en":"","pos":""},{"he":"באחת","en":"","pos":""},{"he":"שלושה","en":"","pos":""},{"he":"האמנם","en":"","pos":""},{"he":"נקרא","en":"","pos":""},{"he":"בראשונה","en":"","pos":""},{"he":"צבא","en":"","pos":""},{"he":"חרש","en":"","pos":""},{"he":"קדם","en":"","pos":""},{"he":"קוראים","en":"","pos":""},{"he":"ליל","en":"","pos":""},{"he":"בכח","en":"","pos":""},{"he":"מיוחדת","en":"","pos":""},{"he":"הנ","en":"","pos":""},{"he":"ומן","en":"","pos":""},{"he":"יאמרו","en":"","pos":""},{"he":"ובא","en":"","pos":""},{"he":"פיה","en":"","pos":""},{"he":"עשתה","en":"","pos":""},{"he":"להאמין","en":"","pos":""},{"he":"חברו","en":"","pos":""},{"he":"מאמין","en":"","pos":""},{"he":"האניה","en":"","pos":""},{"he":"לגבי","en":"","pos":""},{"he":"בנה","en":"","pos":""},{"he":"בעלה","en":"","pos":""},{"he":"ארצות","en":"","pos":""}],"reading":{"workId":"10797","title":"על עבודת הקרן הקימת","author":"מנחם אוסישקין","genre":"essay","text":"התנועה הציונית זקוקה לנקודת אחיזה. זו היא אך ורק הקרקע של ארץ-ישראל. תקווותינו, עמנו, הסתדרותנו, הכל תלוי בקרקע. אם יהיה הקרקע תחת רגלינו, הרי עשרים פאספילדים אינם מסוכנים לנו. אם הקרקע לא יהיה לנו, עשרים בלפורים לא יעזרונו. יהודים בשביל ארץ-ישראל נשיג תמיד, אבל ארץ-ישראל בשביל היהודים היא שאלת השנים הקרובות. לכן נחוץ לנו הקרקע. עם הקרקע נעמוד ובלי הקרקע נפול. וגם להנהגה אני אומר: עם הקרקע היא עומדת ובלי הקרקע היא נופלת. הרצאה בקונגרס הי\"ז, 1931. תרפ\"ט–תרצ\"א &nbsp;↩︎ את הטקסט[ים] לעיל הפיקו מתנדבי פרויקט בן־יהודה באינטרנט. הכל זמין תמיד בכתובת הבאה:https://benyehuda.org/read/10797","words":95,"coverage":78,"practises":0},"src":{"name":"Project Ben-Yehuda","license":"Public domain","credit":"Project Ben-Yehuda volunteers","url":"https://benyehuda.org/read/10797"}}