{"n":45,"level":3,"levelName":"Fluent reading","knownAfter":1650,"words":[{"he":"מכתבים","en":"","pos":""},{"he":"צוה","en":"","pos":""},{"he":"מרה","en":"","pos":""},{"he":"שבעה","en":"","pos":""},{"he":"משל","en":"","pos":""},{"he":"העיקר","en":"","pos":""},{"he":"בקרבי","en":"","pos":""},{"he":"משא","en":"","pos":""},{"he":"האין","en":"","pos":""},{"he":"סימן","en":"","pos":""},{"he":"הנורא","en":"","pos":""},{"he":"סר","en":"","pos":""},{"he":"מדברים","en":"","pos":""},{"he":"חש","en":"","pos":""},{"he":"מאחורי","en":"","pos":""},{"he":"בעיניה","en":"","pos":""},{"he":"ידועה","en":"","pos":""},{"he":"גמורה","en":"","pos":""},{"he":"כסא","en":"","pos":""},{"he":"ואילו","en":"","pos":""},{"he":"אחיטוב","en":"","pos":""},{"he":"החוף","en":"","pos":""},{"he":"פנימה","en":"","pos":""},{"he":"יחס","en":"","pos":""},{"he":"צעד","en":"","pos":""},{"he":"בהיות","en":"","pos":""},{"he":"נסע","en":"","pos":""},{"he":"השונים","en":"","pos":""},{"he":"השער","en":"","pos":""},{"he":"לגלות","en":"","pos":""},{"he":"הקול","en":"","pos":""},{"he":"האל","en":"","pos":""},{"he":"חלום","en":"","pos":""},{"he":"האכרים","en":"","pos":""},{"he":"כאיש","en":"","pos":""},{"he":"כהן","en":"","pos":""},{"he":"בעיקר","en":"","pos":""},{"he":"מקבל","en":"","pos":""},{"he":"להוכיח","en":"","pos":""},{"he":"חפצתי","en":"","pos":""},{"he":"ביחד","en":"","pos":""},{"he":"בים","en":"","pos":""},{"he":"השחר","en":"","pos":""},{"he":"סכנה","en":"","pos":""},{"he":"זוכר","en":"","pos":""},{"he":"גן","en":"","pos":""},{"he":"בפנים","en":"","pos":""},{"he":"כמוני","en":"","pos":""},{"he":"לבלתי","en":"","pos":""},{"he":"זרה","en":"","pos":""}],"reading":{"workId":"18047","title":"פתרון לא־רציונלי","author":"אהרן דוד גורדון","genre":"essay","text":"לבקש קודם־כול תחיית עצמו ותחיית החיים של עצמו. פה אני חי – ועובד עבודת התחייה על־ידי החיים. כמובן, פה אני מבקש חיים חדשים, גם בעבודה אני מוצא חיים, כלומר חיים חדשים: לוּלא כן לא הייתי עובד. זהו העיקר. אם אני מבקש חיים חדשים באמת, כלומר אם אין זה פראזה ריקה, הרי עלי קודם־כול לעזוב את ההשקפה הרגילה על צרכי החיים, על נעימות החיים, על הרחבת החיים – על טעם החיים. אם טעם החיים לא נשתנה אצלי, אין לי מה לבקש חיים חדשים, כי לא אמצאם. חיים חדשים – הרי זה קודם־כול טעם חיים חדש. הדבר הזה כל כך פשוט, עד כי כמעט אין כל פלא, שלא רבים יבינוהו, ושרבים יחשבוהו למוזר. בכל אופן","words":110,"coverage":80,"practises":0},"src":{"name":"Project Ben-Yehuda","license":"Public domain","credit":"Project Ben-Yehuda volunteers","url":"https://benyehuda.org/read/18047"}}