{"n":41,"level":3,"levelName":"Fluent reading","knownAfter":1450,"words":[{"he":"תדע","en":"","pos":""},{"he":"ישן","en":"","pos":""},{"he":"צורה","en":"","pos":""},{"he":"ואך","en":"","pos":""},{"he":"כחו","en":"","pos":""},{"he":"לאשה","en":"","pos":""},{"he":"דניאל","en":"","pos":""},{"he":"שירי","en":"","pos":""},{"he":"שמי","en":"","pos":""},{"he":"הקונגרס","en":"","pos":""},{"he":"ויען","en":"","pos":""},{"he":"אתנו","en":"","pos":""},{"he":"חבריו","en":"","pos":""},{"he":"בעלת","en":"","pos":""},{"he":"דעתי","en":"","pos":""},{"he":"גמור","en":"","pos":""},{"he":"שאול","en":"","pos":""},{"he":"בשתי","en":"","pos":""},{"he":"גדל","en":"","pos":""},{"he":"הישן","en":"","pos":""},{"he":"אגב","en":"","pos":""},{"he":"תעשה","en":"","pos":""},{"he":"לשאול","en":"","pos":""},{"he":"העירה","en":"","pos":""},{"he":"ומדוע","en":"","pos":""},{"he":"מרוב","en":"","pos":""},{"he":"עסק","en":"","pos":""},{"he":"אבות","en":"","pos":""},{"he":"תבל","en":"","pos":""},{"he":"בתורה","en":"","pos":""},{"he":"גבול","en":"","pos":""},{"he":"קמה","en":"","pos":""},{"he":"ריח","en":"","pos":""},{"he":"המחבר","en":"","pos":""},{"he":"עמוד","en":"","pos":""},{"he":"רגל","en":"","pos":""},{"he":"הבה","en":"","pos":""},{"he":"מס","en":"","pos":""},{"he":"באהבה","en":"","pos":""},{"he":"לעומת","en":"","pos":""},{"he":"המלאכה","en":"","pos":""},{"he":"חם","en":"","pos":""},{"he":"והיתה","en":"","pos":""},{"he":"גמר","en":"","pos":""},{"he":"ויתן","en":"","pos":""},{"he":"התפלה","en":"","pos":""},{"he":"בידם","en":"","pos":""},{"he":"לבנו","en":"","pos":""},{"he":"שש","en":"","pos":""},{"he":"ואינם","en":"","pos":""}],"reading":{"workId":"5806","title":"לא זו הדרך","author":"אהרן דוד גורדון","genre":"essay","text":"והחווה הזאת הלא היתה יכולה בשעת חירום זו להביא לנו הרבה ברכה, לוּ היתה ההנהלה רצוּיה, לוּ ידעה את אשר לפניה, לוּ ידעה, מה השעה דורשת ממנה, ולוּ היה רצון למלא בשלמוּת את דרישות השעה. אינני בא לדון ולהורות, לחייב או לזכּות, אינני יודע את העניין בכל פרטיו ולכל עמקו וגם אין לי פה עסק באנשים. יכול להיות, כי האנשים אינם כל־כך גרועים או כי אין לנו לפי שעה טובים מהם, - ואולי לא רק לפי שעה. אני לפחות אינני יודע, את מי מהמנהלים בחווֹת שלנו אפשר להראות בתור מופת. לפי שעה אני רואה רק, כי תפקיד ההנהלה מקלקל את האדם. פה לנגד עיני רק אותו הדבר, שאנו עומדים בו עתה.","words":110,"coverage":78,"practises":0},"src":{"name":"Project Ben-Yehuda","license":"Public domain","credit":"Project Ben-Yehuda volunteers","url":"https://benyehuda.org/read/5806"}}