{"unit":11,"section":1,"cefr":"Intro","objective":"form the possessive","skill":"Possessives 1","heading":"Form the possessive","phrases":[{"he":"הילד שלה אוכל ארוחת צהריים.","en":"Her boy is eating lunch.","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/c1f67ef7c83c48ab60a9478af0c01770","tokens":[{"w":"הילד","h":["the boy is","the boy","the kid"]},{"w":"שלה","h":["her","hers","its"]},{"w":"אוכל","h":["is eating","eating","eats"]},{"w":"ארוחת","h":["lunch"]},{"w":"צהריים","h":["lunch","noon"]}]},{"he":"זה שלךָ?","en":"Is that yours?","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/f592a890b49fb16fbc943ab767007140","tokens":[{"w":"זה","h":["this is","this","it is"]},{"w":"שלךָ","h":["yours (sg.masc.)","your (sg.masc.)"]}]},{"he":"אני אוהב את האוכל שלהם.","en":"I love their food.","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/e87a3cd29dbc757d15708dddbce6e0a6","tokens":[{"w":"אני","h":["I","I am","me"]},{"w":"אוהב","h":["love","like","likes"]},{"w":"את","h":["you"]},{"w":"האוכל","h":["the food"]},{"w":"שלהם","h":["their","theirs"]}]},{"he":"הגמל שלכם?","en":"Is the camel yours?","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/09e17e8cd40a409ec188438314426ff9","tokens":[{"w":"הגמל","h":["the camel is","the camel"]},{"w":"שלכם","h":["yours(p.m.)","yours","your"]}]}],"sentences":[{"he":"זה שלה.","en":"This is hers.","alt":[],"t":"l"},{"he":"זה שלךָ?","en":"Is this yours?","alt":[],"t":"t","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/f592a890b49fb16fbc943ab767007140"},{"he":"הדור שלי!","en":"My generation!","alt":[],"t":"t","inferred":1},{"he":"הגמל שלכם?","en":"Is the camel yours?","alt":[],"t":"t","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/09e17e8cd40a409ec188438314426ff9"},{"he":"האוכל שלךְ?","en":"Is the food yours?","alt":[],"t":"t"},{"he":"זאת אמא שלו.","en":"This is his mom.","alt":[],"t":"l"},{"he":"זה הקמח שלי.","en":"This is my flour.","alt":[],"t":"t","inferred":1},{"he":"הדג שייך לנו.","en":"The fish belongs to us.","alt":[],"t":"t"},{"he":"החתול של שרה.","en":"The cat is Sarah's.","alt":[],"t":"l"},{"he":"זה המיץ שלהן?","en":"Is this their juice?","alt":[],"t":"t"},{"he":"זה התפוח שלי.","en":"This is my apple.","alt":[],"t":"t"},{"he":"החלב של החתול.","en":"The milk of the cat.","alt":[],"t":"t"},{"he":"הם שייכים לכם!","en":"They belong to you!","alt":[],"t":"l"},{"he":"הסוס שלך יפֶה.","en":"Your horse is beautiful.","alt":[],"t":"t"},{"he":"התפוח שייך לי.","en":"The apple belongs to me.","alt":[],"t":"l"},{"he":"אמא שלי כועסת.","en":"My mother is angry.","alt":[],"t":"l","inferred":1},{"he":"הוא הנהג שלנו.","en":"He is our driver.","alt":[],"t":"t","inferred":1},{"he":"הילד שלכם שמח!","en":"Your boy is happy!","alt":[],"t":"t","inferred":1},{"he":"זה המטבח שלנו.","en":"This is our kitchen.","alt":[],"t":"t","inferred":1},{"he":"החתול שלי אוכל.","en":"My cat is eating.","alt":[],"t":"t"},{"he":"הכלב שלהן הולך.","en":"Their dog is walking.","alt":[],"t":"t"},{"he":"הסוס שלהם יפֶה!","en":"Their horse is beautiful!","alt":[],"t":"t"},{"he":"הסוס שלךְ יפֶה.","en":"Your horse is pretty.","alt":[],"t":"l"},{"he":"הסלט שלךָ טעים!","en":"Your salad is tasty!","alt":[],"t":"l"},{"he":"התות שלכן מתוק!","en":"Your strawberry is sweet!","alt":[],"t":"l"},{"he":"התפוז שלו טעים.","en":"His orange is tasty.","alt":[],"t":"t"},{"he":"זאת הבירה שלנו.","en":"This is our beer.","alt":[],"t":"l"},{"he":"זה שלי או שלךָ?","en":"Is this mine or yours?","alt":[],"t":"t"},{"he":"זאת הילדה שלכם?","en":"Is this your girl?","alt":[],"t":"t","inferred":1},{"he":"זאת המפית שלךָ?","en":"Is this your napkin?","alt":[],"t":"t","inferred":1},{"he":"הבננה שלי טעימה!","en":"My banana is tasty!","alt":[],"t":"l"},{"he":"הסוכר שלכן מתוק!","en":"Your sugar is sweet!","alt":[],"t":"t"},{"he":"אבא שלו הוא נהג.","en":"His dad is a driver.","alt":[],"t":"t","inferred":1},{"he":"האם זאת החצר שלה?","en":"Is this her yard?","alt":[],"t":"t","inferred":1},{"he":"הגינה שלנו ירוקה.","en":"Our garden is green.","alt":[],"t":"l","i