{"unit":10,"section":1,"cefr":"Intro","objective":"form the plural","skill":"Plurals","heading":"Form the plural","phrases":[{"he":"הוא קורא עיתונים או ספרים?","en":"Does he read newspapers or books?","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/3d9352c0bec72fc46421a729103275f0","tokens":[{"w":"הוא","h":["(he) is","he","(it) is"]},{"w":"קורא","h":["is reading","read","reading"]},{"w":"עיתונים","h":["newspapers"]},{"w":"או","h":["or"]},{"w":"ספרים","h":["books"]}]},{"he":"התפוחים טעימים, תודה!","en":"The apples are tasty, thanks!","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/f874697f1fdb06d583b75d7622a30ae3","tokens":[{"w":"התפוחים","h":["the apples"]},{"w":"טעימים","h":["are tasty","tasty (pl. masc.)","are delicious"]},{"w":"תודה","h":["thank you","thanks"]}]},{"he":"הספרים יפים.","en":"The books are pretty.","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/67c7d7e2c0feb171e578a84efe1f0620","tokens":[{"w":"הספרים","h":["the books are","the books"]},{"w":"יפים","h":["nice","beautiful (pl. masc.)","handsome"]}]},{"he":"החתולים שותים את החלב.","en":"The cats are drinking the milk.","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/e9aaae27000b5a0c2d62a0431c4530f0","tokens":[{"w":"החתולים","h":["the cats"]},{"w":"שותים","h":["are drinking","drinking","drink"]},{"w":"את","h":["the milk","you"]},{"w":"החלב","h":["the milk","the milk","milk","the milk is"]}]}],"sentences":[{"he":"פרות!","en":"Cows!","alt":[],"t":"t"},{"he":"הסוסים.","en":"The horses.","alt":[],"t":"t"},{"he":"הספרים.","en":"The books.","alt":[],"t":"t"},{"he":"אין דרכים.","en":"There are no ways.","alt":[],"t":"t"},{"he":"חיות מחמד.","en":"Pets.","alt":[],"t":"t"},{"he":"האריות יפים.","en":"The lions are pretty.","alt":[],"t":"t"},{"he":"הספרים יפים.","en":"The books are nice.","alt":[],"t":"l","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/67c7d7e2c0feb171e578a84efe1f0620"},{"he":"העוגות יפות.","en":"The cakes are pretty.","alt":[],"t":"l"},{"he":"יש לה סוסים.","en":"She has horses.","alt":[],"t":"l"},{"he":"יש להם צבים.","en":"They have turtles.","alt":[],"t":"t"},{"he":"יש לו דרכים.","en":"He has ways.","alt":[],"t":"t"},{"he":"יש לי כלבים.","en":"I have dogs.","alt":[],"t":"t"},{"he":"פרות ופירות.","en":"Cows and fruits.","alt":[],"t":"t"},{"he":"האריות שמחים.","en":"The lions are happy.","alt":[],"t":"t"},{"he":"יש לנו כלבות.","en":"We have female dogs.","alt":[],"t":"t"},{"he":"יש לנו צלחות?","en":"Do we have plates?","alt":[],"t":"l"},{"he":"כלבים וכלבות.","en":"Male dogs and female dogs.","alt":[],"t":"t"},{"he":"סוסים ודרכים.","en":"Horses and roads.","alt":[],"t":"t"},{"he":"ספרים ארוכים.","en":"Long books.","alt":[],"t":"t","inferred":1},{"he":"הבירות טעימות.","en":"The beers are delicious.","alt":[],"t":"t"},{"he":"היינות טעימים.","en":"The wines are tasty.","alt":[],"t":"t"},{"he":"הכלבים נובחים.","en":"The dogs are barking.","alt":[],"t":"t"},{"he":"העוגות טעימות!","en":"The cakes are tasty!","alt":[],"t":"t"},{"he":"יש לךָ חתולים?","en":"Do you have cats?","alt":[],"t":"t"},{"he":"הסוסות אוכלות.","en":"The mares are eating.","alt":[],"t":"l","inferred":1},{"he":"יש לי ברווזות!","en":"I have female ducks!","alt":[],"t":"l","inferred":1},{"he":"אבא קורא ספרים.","en":"Dad is reading books.","alt":[],"t":"t"},{"he":"הכריכים טעימים.","en":"The sandwiches are tasty.","alt":[],"t":"t"},{"he":"חתולים וחתולות.","en":"Male cats and female cats.","alt":[],"t":"l"},{"he":"יש לכם ציפורים?","en":"Do you have birds?","alt":[],"t":"t"},{"he":"יש לנו עיתונים?","en":"Do we have newspapers?","alt":[],"t":"t"},{"he":"אין להם ברווזים.","en":"They do not have ducks.","alt":[],"t":"t"},{"he":"אני אוכל תפוחים.","en":"I am eating apples.","alt":[],"t":"t"},{"he":"אני רואֶה צלחות.","en":"I see plates.","alt":[],"t":"t"},{"he":"אני שותֶה בירות.","en":"I am drinking beers.","alt":[],"t":"l"},{"he":"את אוכלת כריכים?","en":"Do you eat sandwiches?","alt":[],"t":"t"},{"he":"הוא אוכל תפוזים.","en":"He is eating oranges.","alt":[],"t":"t"},{"he":"הפרות שותו