{"unit":127,"section":5,"cefr":"B1","objective":"discuss academic topics","skill":"Academia","heading":"Academic vocabulary","phrases":[{"he":"המחקר הזה חשוב מאוד.","en":"This research is very important.","audio":"","tokens":[{"w":"המחקר","h":["the research"]},{"w":"הזה","h":["this (m)"]},{"w":"חשוב","h":["important"]},{"w":"מאוד","h":["very"]}]},{"he":"הפרופסור נתן הרצאה מצוינת.","en":"The professor gave an excellent lecture.","audio":"","tokens":[{"w":"הפרופסור","h":["the professor"]},{"w":"נתן","h":["gave"]},{"w":"הרצאה","h":["a lecture"]},{"w":"מצוינת","h":["excellent"]}]},{"he":"הסטודנט כתב מאמר ארוך.","en":"The student wrote a long article.","audio":"","tokens":[{"w":"הסטודנט","h":["the student"]},{"w":"כתב","h":["wrote"]},{"w":"מאמר","h":["an article","a paper"]},{"w":"ארוך","h":["long"]}]},{"he":"הניסוי הוכיח את התיאוריה.","en":"The experiment proved the theory.","audio":"","tokens":[{"w":"הניסוי","h":["the experiment"]},{"w":"הוכיח","h":["proved"]},{"w":"את","h":["(object marker)"]},{"w":"התיאוריה","h":["the theory"]}]},{"he":"היא קיבלה תואר בפסיכולוגיה.","en":"She received a degree in psychology.","audio":"","tokens":[{"w":"היא","h":["she"]},{"w":"קיבלה","h":["received"]},{"w":"תואר","h":["a degree"]},{"w":"בפסיכולוגיה","h":["in psychology"]}]}],"sentences":[{"he":"זה מחקר חדש.","en":"This is new research.","alt":[],"t":"t"},{"he":"הוא פרופסור.","en":"He is a professor.","alt":[],"t":"t"},{"he":"אני סטודנט.","en":"I am a student.","alt":[],"t":"l"},{"he":"ההרצאה הייתה טובה.","en":"The lecture was good.","alt":[],"t":"t"},{"he":"יש לי תואר.","en":"I have a degree.","alt":[],"t":"t"},{"he":"הניסוי הצליח.","en":"The experiment succeeded.","alt":[],"t":"l"},{"he":"המאמר מעניין.","en":"The article is interesting.","alt":[],"t":"t"},{"he":"התיאוריה חדשה.","en":"The theory is new.","alt":[],"t":"t"},{"he":"מי כתב את המאמר?","en":"Who wrote the article?","alt":[],"t":"t"},{"he":"הסטודנט לומד כל יום.","en":"The student studies every day.","alt":[],"t":"l"},{"he":"ה