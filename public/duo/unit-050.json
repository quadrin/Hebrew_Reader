{"unit":50,"section":2,"cefr":"A1","objective":"describe emergencies","skill":"Emergency!","heading":"Describe emergencies","phrases":[{"he":"זהירות!","en":"Careful!","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/53bbe0e9d646072119ad2717c1219e00","tokens":[{"w":"זהירות","h":["watch out","careful","warning"]}]},{"he":"אני צריך עזרה.","en":"I need help.","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/8efe51c799302a8cbcd24b6a74069f28","tokens":[{"w":"אני","h":["I","I am","me"]},{"w":"צריך","h":["need","needs","have to"]},{"w":"עזרה","h":["help"]}]},{"he":"יש לנו מקרה חירום.","en":"We have got an emergency.","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/36ec455d320ca546037846f407a6c18f","tokens":[{"w":"יש","h":["we have","have","there are","has"]},{"w":"לנו","h":["we have","to us","us","for us"]},{"w":"מקרה","h":["an emergency","emergency","case","a case"]},{"w":"חירום","h":["an emergency","emergency"]}]},{"he":"הם לכודים.","en":"They are trapped.","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/cf20ccffd11a24e4a85ddfef1af1f358","tokens":[{"w":"הם","h":["they are","are","they"]},{"w":"לכודים","h":["trapped"]}]},{"he":"צוות החילוץ מגיע.","en":"The rescue team is arriving.","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/5d7c32de72833257ce6b23099b71c7ea","tokens":[{"w":"צוות","h":["team","a team","crew"]},{"w":"החילוץ","h":["the rescue"]},{"w":"מגיע","h":["is coming","is arriving","arrives"]}]}],"sentences":[{"he":"הצילו!","en":"Help!","alt":[],"t":"t"},{"he":"זהירות!","en":"Careful!","alt":[],"t":"l","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/53bbe0e9d646072119ad2717c1219e00"},{"he":"הם לכודים.","en":"They are trapped.","alt":[],"t":"t","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/cf20ccffd11a24e4a85ddfef1af1f358"},{"he":"נפלתי מהגג.","en":"I fell from the roof.","alt":[],"t":"t"},{"he":"יש פה שריפה!","en":"There is a fire here!","alt":[],"t":"l"},{"he":"האם הוא כבאי?","en":"Is he a firefighter?","alt":[],"t":"t"},{"he":"זה היה פיצוץ!","en":"It was a blast!","alt":[],"t":"l"},{"he":"אני צריך עזרה.","en":"I need help.","alt":[],"t":"l","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/8efe51c799302a8cbcd24b6a74069f28"},{"he":"הכלב שלי לכוד!","en":"My dog is trapped!","alt":[],"t":"t"},{"he":"זה מסוכן מאוד.","en":"This is very dangerous.","alt":[],"t":"t"},{"he":"זה מקרה חירום!","en":"It is an emergency!","alt":[],"t":"l"},{"he":"לא איבדתי הכרה.","en":"I didn't lose consciousness.","alt":[],"t":"t"},{"he":"אנחנו לא במצוקה.","en":"We are not in distress.","alt":[],"t":"l"},{"he":"אף אחד לא מתעלף.","en":"No one is passing out.","alt":[],"t":"t"},{"he":"ראיתם את הפיצוץ?","en":"Did you see the explosion?","alt":[],"t":"t"},{"he":"הצילו! אמר החתול.","en":"Help me! said the cat.","alt":[],"t":"t"},{"he":"הצילו, אני נופלת!","en":"Help, I'm falling!","alt":[],"t":"t"},{"he":"צוות החילוץ מגיע.","en":"The rescue team is coming.","alt":[],"t":"t","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/5d7c32de72833257ce6b23099b71c7ea"},{"he":"אין פצועים בתאונה.","en":"There are no injured people in the accident.","alt":[],"t":"t"},{"he":"אני \"טובע\" בעבודה.","en":"I am \"drowning\" in work.","alt":[],"t":"t"},{"he":"הייתָ בתאונה הזאת?","en":"Were you in that accident?","alt":[],"t":"l"},{"he":"זהירות - כלב בחצר.","en":"Caution - dog in the yard.","alt":[],"t":"l"},{"he":"יש לנו מקרה חירום.","en":"We have an emergency.","alt":[],"t":"t","audio":"https://d1vq87e9lcf771.cloudfront.net/he_v1/36ec455d320ca546037846f407a6c18f"},{"he":"מישהו אמר \"הצילו\"?","en":"Did someone say \"help me\"?","alt":[],"t":"l"},{"he":"מתי התחילה השריפה?","en":"When did the fire start?","alt":[],"t":"l"},{"he":"אנחנו צריכים חילוץ!","en":"We need rescuing!","alt":[],"t":"t"},{"he":"היא מחלצת את הארנב.","en":"She rescues the bunny.","alt":[],"t":"t"},{"he":"הכבאים מחלצים אותם.","en":"The firefighters rescue them.","alt":[],"t":"t"},{"he":"זה כמו שאתה מתחשמל.","en":"It's like you are getting electrocuted.","alt":[],"t":"t"},{"he":"יש פה עשרים פצועים.","en":"There are twenty injured people here.","alt":[],"t":"l"},{"he":"אבא שלי תמיד מתחשמל.","en":"My dad is always getting electrocuted.","alt":[],"t":"t"},{"he":"אף אחד לא מאבד הכרה.","en":"No one loses consciousness.","alt":[],"t":"l"},{"he":"זאת לא אזעקה אמיתית.","en":"It isn't a real alarm.","alt":[],"t":"t"},{"he":"זהירות - רצפה רטובה.","en":"Caution - wet floor.","alt":[],"t":"t"},{"he":"תודה על העזרה, באמת!","en":"Thanks for helping, really!","alt":[],"t":"l"},{"he":"אני מחלץ את הגרב שלי.","en":"I rescue my sock.","alt":[],"t":"t"},{"he":"יש שריפה בגלל הפיצוץ.","en":"There is a fire because of the explosion.","alt":[],"t":"l"},{"he":"אני מכיר חובשת מצוינת!","en":"I know an excellent medic!","alt":[],"t":"l"},{"he":"הגבר פצוע אחרי התאונה.","en":"The man is injured after the accident.","alt":[],"t":"t"},{"he":"הוא לא רופא, אלא חובש.","en":"He is not a doctor, but a medic.","alt":[],"t":"l"},{"he":"הוא עוזר לאנשים במצוקה.","en":"He helps the people in distress.","alt":[],"t":"t"},{"he":"החובש יודע עזרה ראשונה.","en":"The medic knows first aid.","alt":[],"t":"l"},{"he":"הוא עושֶה דברים מסוכנים.","en":"He does dangerous things.","alt":[],"t":"l"},{"he":"החובשת מבצעת את ההחייאה.","en":"The medic performs CPR.","alt":[],"t":"l"},{"he":"מה עושים כששומעים אזעקה?","en":"What do you do when you hear a siren?","alt":[],"t":"l"},{"he":"החובש עובד במגן דוד אדום.","en":"The medic works in Magen David Adom.","alt":[],"t":"l"},{"he":"הכלב רוצֶה את העזרה שלךָ.","en":"The dog wants your help.","alt":[],"t":"t"},{"he":"הכבאי הזה אחראי על החילוץ.","en":"This firefighter is responsible for the rescue.","alt":[],"t":"t"},{"he":"אני יודעת איך לעשות החייאה.","en":"I know how to do CPR.","alt":[],"t":"t"},{"he":"העכברים מתחשמלים בגלל הברק.","en":"The mice are getting electrocuted because of the lightning.","alt":[],"t":"t"},{"he":"הוא כל כך חכם, אני \"מתעלפת\".","en":"He is so smart, I'm \"floored\".","alt":[],"t":"t"},{"he":"כולם חושבים שזה רעיון מסוכן.","