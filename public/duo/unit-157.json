,"alt":[],"from":"lexicon","tr":"guf"},{"he":"נשמה","en":"soul","alt":[],"from":"lexicon","tr":"neshamah"},{"he":"פצע","en":"wound","alt":[],"from":"lexicon","tr":"petza"},{"he":"ריפוי","en":"healing","alt":[],"from":"lexicon","tr":"ripui"},{"he":"שקט","en":"quiet","alt":["silence"],"from":"lexicon","tr":"sheket"},{"he":"משורר","en":"poet","alt":[],"from":"skill"},{"he":"שירה","en":"poetry","alt":[],"from":"skill"},{"he":"תמימות","en":"innocence","alt":[],"from":"skill"},{"he":"זיכרונות","en":"memories","alt":[],"from":"skill"},{"he":"פצעים","en":"wounds","alt":[],"from":"skill"},{"he":"מרפאה","en":"heals (f.)","alt":[],"from":"skill"},{"he":"שירים","en":"poems","alt":[],"from":"phrase"}],"lexemes":["אלוהים","תפילה","ילדות","מלחמה","אהבה","עיר","ירושלים","זמן","גוף","נשמה","פצע","פצעים","ריפוי","שקט","משורר","שירה","שירים","תמימות","זיכרונות","מרפאה","נרפא"],"tips":"Yehuda Amichai (1924-2000) revolutionized Hebrew poetry by writing in spoken language."}