{"unit":123,"section":5,"cefr":"B1","objective":"discuss advanced business","skill":"Business 2","heading":"Advanced business","phrases":[{"he":"המניות עלו בבורסה היום.","en":"The stocks went up on the stock exchange today.","audio":"","tokens":[{"w":"המניות","h":["the stocks","the shares"]},{"w":"עלו","h":["went up","rose"]},{"w":"בבורסה","h":["on the stock exchange"]},{"w":"היום","h":["today"]}]},{"he":"ישראל מייצאת טכנולוגיה לכל העולם.","en":"Israel exports technology to the whole world.","audio":"","tokens":[{"w":"ישראל","h":["Israel"]},{"w":"מייצאת","h":["exports (f.)"]},{"w":"טכנולוגיה","h":["technology"]},{"w":"לכל","h":["to all / the whole"]},{"w":"העולם","h":["the world"]}]},{"he":"היזם הקים חברה חדשה.","en":"The entrepreneur founded a new company.","audio":"","tokens":[{"w":"היזם","h":["the entrepreneur"]},{"w":"הקים","h":["founded","established"]},{"w":"חברה","h":["company"]},{"w":"חדשה","h":["new (f.)"]}]},{"he":"הרווח של החברה גדל השנה.","en":"The company's profit grew this year.","audio":"","tokens":[{"w":"הרווח","h":["the profit"]},{"w":"של","h":["of"]},{"w":"החברה","h":["the company"]},{"w":"גדל","h":["grew"]},{"w":"השנה","h":["this year"]}]},{"he":"השוק משתנה כל הזמן.","en":"The market changes all the time.","audio":"","tokens":[{"w":"השוק","h":["the market"]},{"w":"משתנה","h":["changes"]},{"w":"כל","h":["all"]},{"w":"הזמן","h":["the time"]}]}],"sentences":[{"he":"הבורסה עלתה היום.","en":"The stock exchange went up today.","alt":[],"t":"t"},{"he":"יש לו מניות.","en":"He has stocks.","alt":[],"t":"l"},{"he":"אנחנו מייבאים סחורה.","en":"We import goods.","alt":[],"t":"t"},{"he":"הם מייצאים פירות.","en":"They export fruit.","alt":[],"t":"t"},{"he":"היזם הצליח.","en":"The entrepreneur succeeded.","alt":[],"t":"l"},{"he":"החברה גדולה.","en":"The company is big.","alt":[],"t":"t"},{"he":"השוק פתוח.","en":"The market is open.","alt":[],"t":"t"},{"he":"הרווח היה גבוה.","en":"The profit was high.","alt":[],"t":"l"},{"he":"הסחר בין המדינות גדל.","en":"Trade b